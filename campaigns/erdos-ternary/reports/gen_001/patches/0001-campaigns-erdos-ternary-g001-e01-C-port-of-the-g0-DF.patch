@@ -0,0 +1,263 @@
+/* g1 engine (experiment g001-e01): C port of the g0 DFS, rules per verify/CERT.md.
+ *
+ * usage: tree_c1 <N decimal> <i> <m> <d0>
+ * prints to stdout:
+ *   depth_counts <c1> <c2> ...      (trailing zeros dropped)
+ *   exceptions <e1> <e2> ...        (sorted ascending)
+ *   events <count>
+ *   sum <16 hex>
+ *   xor <16 hex>
+ * search/run.py turns this into the certificate JSON (sha256 digest computed there).
+ *
+ * Representation: v = 2^r mod 3^L kept in NLIMB limbs of base B = 3^40 (L = 40*NLIMB trits),
+ * little-endian. Children values: v * 2^(P_k) mod 3^L with a truncated schoolbook mulmod; every
+ * 128-by-64 reduction by B uses a precomputed inverse (Moller-Granlund 2011, "Improved division by
+ * invariant integers", Alg. 4; B >= 2^63 so B is normalised).
+ * r is unsigned __int128. P_k = 2*3^(k-1) is kept mod 2^128 together with a flag "P_k > N"; the event
+ * hash only depends on r mod 2^128 (see splitmix masking in CERT.md), so wrapped child indices hash
+ * correctly, and the flag decides the r > N test exactly.
+ * Any candidate deeper than L trits aborts with exit code 3 (never silently truncates).
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef unsigned __int128 u128;
+typedef uint64_t u64;
+
+#ifndef NLIMB
+#define NLIMB 6
+#endif
+#define LTRITS (40 * NLIMB)
+#define BASE 12157665459056928801ULL /* 3^40 */
+
+static u64 BINV; /* floor((2^128-1)/BASE) - 2^64 */
+
+static void die(const char *msg) {
+    fprintf(stderr, "tree_c1: FATAL: %s\n", msg);
+    exit(3);
+}
+
+/* (u1:u0) with u1 < BASE  ->  quotient q, remainder *rem */
+static inline u64 divB(u64 u1, u64 u0, u64 *rem) {
+    u128 q = (u128)BINV * u1;
+    q += ((u128)u1 << 64) | u0;
+    u64 q1 = (u64)(q >> 64) + 1, q0 = (u64)q;
+    u64 r = u0 - q1 * BASE;
+    if (r > q0) { q1--; r += BASE; }
+    if (r >= BASE) { q1++; r -= BASE; }
+    *rem = r;
+    return q1;
+}
+
+/* out = a*b mod 3^L (out may not alias a or b) */
+static inline void mulmod(const u64 *a, const u64 *b, u64 *out) {
+    u64 res[NLIMB];
+    memset(res, 0, sizeof res);
+    for (int i = 0; i < NLIMB; i++) {
+        u64 ai = a[i], carry = 0;
+        if (!ai) continue;
+        for (int j = 0; j < NLIMB - i; j++) {
+            u128 t = (u128)ai * b[j] + res[i + j] + carry; /* <= B^2 - 1 < B*2^64 */
+            carry = divB((u64)(t >> 64), (u64)t, &res[i + j]);
+        }
+    }
+    memcpy(out, res, sizeof res);
+}
+
+static u64 POW3[40];
+/* trit number t (0-based, least significant first) of v */
+static inline int trit(const u64 *v, int t) { return (int)((v[t / 40] / POW3[t % 40]) % 3); }
+
+static inline u64 mix(u64 z) {
+    z += 0x9E3779B97F4A7C15ULL;
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+    return z ^ (z >> 31);
+}
+
+static u128 N;
+static int record_low; /* this shard records levels <= d0 (shard 0) */
+static u64 ev_cnt, ev_sum, ev_xor;
+static u64 counts[LTRITS + 2];
+static int maxlev;
+static u128 *exc; static size_t nexc, capexc;
+
+/* per level k (1..LTRITS): P_k mod 2^128, P_k > N flag, bitlength of 3^k, G_k = 2^(P_k), G_k^2 mod 3^L */
+static u128 Pk[LTRITS + 2];
+static int Pbig[LTRITS + 2];
+static int BL3[LTRITS + 2];
+static u64 G1[LTRITS + 2][NLIMB], G2[LTRITS + 2][NLIMB];
+
+static inline void emit(int k, u128 r, int code) {
+    u64 h = mix(mix(mix((u64)r) ^ (u64)(r >> 64)) ^ (u64)(4 * k + code));
+    ev_cnt++; ev_sum += h; ev_xor ^= h;
+}
+
+typedef struct { u128 r; u64 v[NLIMB]; int k; int e; } node;
+
+/* classify candidate (k, r) with value v = 2^r mod 3^L; big = r is known > N.
+ * returns 1 if alive (and sets *e). */
+static inline int candidate(int k, u128 r, int big, const u64 *v, int record, int *e) {
+    if (big || r > N) { if (record) emit(k, r, 1); return 0; }
+    if (k > LTRITS) die("candidate depth exceeds the limb capacity (raise NLIMB)");
+    if (trit(v, k - 1) == 2) { if (record) emit(k, r, 0); return 0; }
+    *e = (r < (u128)BL3[k]) && (Pbig[k] || r + Pk[k] > N);
+    if (record) {
+        counts[k]++;
+        if (k > maxlev) maxlev = k;
+        if (*e) {
+            emit(k, r, 2);
+            if (nexc == capexc) { capexc = capexc ? 2 * capexc : 16; exc = realloc(exc, capexc * sizeof *exc); if (!exc) die("oom"); }
+            exc[nexc++] = r;
+        }
+    }
+    return 1;
+}
+
+/* children of alive node nd, appended to out[*n] */
+static inline void children(const node *nd, int record, node *out, size_t *n) {
+    if (nd->e) return;
+    int k = nd->k, kc = k + 1;
+    if (kc > LTRITS) die("child depth exceeds the limb capacity (raise NLIMB)");
+    u128 P = Pk[k];
+    int big = Pbig[k];
+    for (int j = 0; j < 3; j++) {
+        u128 rc = nd->r + (u128)j * P; /* mod 2^128 when big */
+        int cbig = big && j > 0;
+        node *c = &out[*n];
+        if (!cbig && rc <= N) {
+            if (j == 0) memcpy(c->v, nd->v, sizeof c->v);
+            else mulmod(nd->v, j == 1 ? G1[k] : G2[k], c->v);
+        }
+        int e = 0;
+        if (candidate(kc, rc, cbig, c->v, record, &e)) {
+            c->k = kc; c->r = rc; c->e = e; (*n)++;
+        }
+    }
+}
+
+static u128 parse_u128(const char *s) {
+    u128 x = 0;
+    if (!*s) die("empty N");
+    for (; *s; s++) {
+        if (*s < '0' || *s > '9') die("N must be decimal");
+        if (x > ((u128)1 << 120)) die("N too large");
+        x = x * 10 + (u128)(*s - '0');
+    }
+    return x;
+}
+
+static void print_u128(u128 x) {
+    char buf[48]; int p = 47; buf[p] = 0;
+    if (!x) buf[--p] = '0';
+    while (x) { buf[--p] = (char)('0' + (int)(x % 10)); x /= 10; }
+    fputs(buf + p, stdout);
+}
+
+static int cmp128(const void *a, const void *b) {
+    u128 x = *(const u128 *)a, y = *(const u128 *)b;
+    return x < y ? -1 : x > y;
+}
+
+static int cmpn(const void *a, const void *b);
+
+static void selftest(void) {
+    /* reduction check against plain 128-bit division */
+    u64 s = 0x1234567;
+    for (int it = 0; it < 100000; it++) {
+        s = mix(s); u64 u1 = s % BASE; s = mix(s); u64 u0 = s, rm;
+        u128 x = ((u128)u1 << 64) | u0;
+        u64 q = divB(u1, u0, &rm);
+        if (q != (u64)(x / BASE) || rm != (u64)(x % BASE)) die("divB self-test failed");
+    }
+}
+
+int main(int argc, char **argv) {
+    if (argc != 5) { fprintf(stderr, "usage: tree_c1 N i m d0\n"); return 2; }
+    N = parse_u128(argv[1]);
+    if (N >= ((u128)1 << 100)) die("N >= 2^100 not supported");
+    int si = atoi(argv[2]), sm = atoi(argv[3]), d0 = atoi(argv[4]);
+    if (sm < 1 || si < 0 || si >= sm || d0 < 1 || d0 >= LTRITS) die("bad shard / d0");
+    record_low = (si == 0);
+
+    BINV = (u64)(((u128)(~BASE) << 64 | ~(u64)0) / BASE);
+    POW3[0] = 1;
+    for (int i = 1; i < 40; i++) POW3[i] = POW3[i - 1] * 3;
+    selftest();
+
+    /* bitlength of 3^k, exact, with a small binary bignum */
+    {
+        uint32_t a[64] = {1}; int na = 1;
+        for (int k = 1; k <= LTRITS; k++) {
+            u64 c = 0;
+            for (int i = 0; i < na; i++) { u64 t = (u64)a[i] * 3 + c; a[i] = (uint32_t)t; c = t >> 32; }
+            if (c) { if (na == 64) die("bignum"); a[na++] = (uint32_t)c; }
+            int top = 31; while (!((a[na - 1] >> top) & 1)) top--;
+            BL3[k] = 32 * (na - 1) + top + 1;
+        }
+    }
+    /* P_k and G_k */
+    {
+        u128 P = 2; int big = 0;
+        u64 g[NLIMB] = {4}, t[NLIMB];
+        for (int k = 1; k <= LTRITS; k++) {
+            Pk[k] = P; Pbig[k] = big || P > N;
+            memcpy(G1[k], g, sizeof g);
+            mulmod(g, g, G2[k]);
+            /* next: P *= 3, g = g^3 */
+            if (P >= ((u128)1 << 100)) big = 1;
+            P *= 3;
+            mulmod(G2[k], g, t);
+            memcpy(g, t, sizeof t);
+        }
+    }
+
+    /* level 1 */
+    size_t cap = 1 << 16, nl = 0;
+    node *lev = malloc(cap * sizeof *lev), *nxt;
+    if (!lev) die("oom");
+    for (int r = 0; r < 2; r++) {
+        node c; memset(&c, 0, sizeof c);
+        c.v[0] = r ? 2 : 1;
+        int e = 0;
+        if (candidate(1, (u128)r, 0, c.v, record_low, &e)) { c.k = 1; c.r = r; c.e = e; lev[nl++] = c; }
+    }
+    /* breadth-first to level d0 */
+    for (int k = 1; nl && k < d0; k++) {
+        size_t ncap = 3 * nl + 3, nn = 0;
+        nxt = malloc(ncap * sizeof *nxt);
+        if (!nxt) die("oom");
+        for (size_t t = 0; t < nl; t++) children(&lev[t], record_low, nxt, &nn);
+        free(lev); lev = nxt; nl = nn;
+    }
+    /* roots: alive nodes at level d0 sorted by r ascending; node t belongs to shard t mod m */
+    qsort(lev, nl, sizeof *lev, cmpn);
+    /* depth-first below level d0 */
+    size_t scap = 4 * (LTRITS + 4), sp = 0;
+    node *stack = malloc(scap * sizeof *stack);
+    if (!stack) die("oom");
+    for (size_t t = si; t < nl; t += sm) {
+        stack[0] = lev[t]; sp = 1;
+        while (sp) {
+            node cur = stack[--sp];
+            if (sp + 3 > scap) die("stack overflow");
+            children(&cur, 1, stack, &sp);
+        }
+    }
+
+    qsort(exc, nexc, sizeof *exc, cmp128);
+    fputs("depth_counts", stdout);
+    for (int k = 1; k <= maxlev; k++) printf(" %llu", (unsigned long long)counts[k]);
+    fputs("\nexceptions", stdout);
+    for (size_t t = 0; t < nexc; t++) { putchar(' '); print_u128(exc[t]); }
+    printf("\nevents %llu\nsum %016llx\nxor %016llx\n", (unsigned long long)ev_cnt,
+           (unsigned long long)ev_sum, (unsigned long long)ev_xor);
+    return 0;
+}
+
+static int cmpn(const void *a, const void *b) {
+    u128 x = ((const node *)a)->r, y = ((const node *)b)->r;
+    return x < y ? -1 : x > y;
+}
